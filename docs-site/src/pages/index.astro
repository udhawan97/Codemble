---
/**
 * Codemble landing — the current app is the design proof.
 *
 * Macrostructure: Hallmark Workbench. Real product captures lead; the Formal
 * Edo system supplies material and typography without turning the site into a
 * decorative atlas. release.json owns stable package facts; repository captures
 * show the newer current-source preview and are labelled separately.
 */
import AtlasJourney from "../components/AtlasJourney.astro";
import Search from "../components/Search.astro";
import release from "../../release.json";
import "../styles/tokens.css";
import "../styles/landing.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const doc = (slug: string) => `${base}/${slug}/`;
const icon = (name: string) => `${base}/brand/icons/${name}.svg`;
const shot = (name: string) => `${base}/shots/${name}`;

const REPO = "https://github.com/udhawan97/Codemble";
const PUBLIC_URL = "https://udhawan97.github.io/Codemble/";
const META_TITLE = "Codemble — explore the code AI left behind";
const META_DESCRIPTION =
  "Explore a local codebase as a parser-proven galaxy or architecture diagram, then light only what you prove you understand.";
const SOCIAL_IMAGE = "https://udhawan97.github.io/Codemble/brand/social-card.png";
const SOCIAL_IMAGE_ALT =
  "Codemble's luminous code galaxy with colourful language systems and parser-owned routes.";
const VERSION = release.version;
const RELEASE = release.releaseUrl;
const WHEEL = release.wheel.url;
const SOURCE_ARCHIVE = release.sdist.url;
const DIGESTS = release.checksums.url;
const INSTALL = `uvx --from codemble==${VERSION} codemble`;

const capabilities = [
  {
    icon: "compass",
    title: "Choose your launch",
    body: "Start in a luminous, fully visible galaxy or take a bounded First Flight from Home. Explore keeps every system colourful; Learning can quiet distant context while guiding one honest route.",
  },
  {
    icon: "map",
    title: "Enter a living solar system",
    body: "The module anchor is its Sun. Named functions and classes become language-styled worlds in call orbits that keep direct calls and call roots distinct, while a nearby-systems console follows parser-owned inbound and outbound imports with certainty intact.",
  },
  {
    icon: "impact",
    title: "Know what a change touches",
    body: "Impact traces what depends on a structure and what it depends on, with real file locations and certainty labels—no model required.",
  },
  {
    icon: "check",
    title: "Prove what you understand",
    body: "Graph-derived checks are the only way to light a system amber. Visiting and understanding remain two different claims.",
  },
  {
    icon: "shield",
    title: "Keep the project local",
    body: "Parsing, maps, feature journeys, source, Impact, checks, and progress stay on your machine. Optional narration goes only to the provider you configure.",
  },
  {
    icon: "languages",
    title: "Read nine languages together",
    body: "Python, JavaScript, TypeScript, Go, Java, Rust, C#, Ruby, and PHP share one honest graph contract, including mixed projects.",
  },
];

const contract = [
  "Nodes, routes, concepts, Home candidates, and application roles come from parsers—not generated prose.",
  "A feature journey stops where proof stops, before showing a visibly possible frontier.",
  "Impact and checks are graph-derived and work without any API key.",
  "Narration may name only supplied identifiers and cite real source lines.",
  "Changing a file re-dims only the proof attached to that file.",
  "Unsupported or broken source is counted and named instead of silently omitted.",
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{META_TITLE}</title>
    <meta name="description" content={META_DESCRIPTION} />
    <link rel="canonical" href={PUBLIC_URL} />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/brand/icon-180.png`} />
    <meta name="theme-color" content="#070b1c" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={PUBLIC_URL} />
    <meta property="og:title" content={META_TITLE} />
    <meta property="og:description" content={META_DESCRIPTION} />
    <meta property="og:image" content={SOCIAL_IMAGE} />
    <meta property="og:image:alt" content={SOCIAL_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={META_TITLE} />
    <meta name="twitter:description" content={META_DESCRIPTION} />
    <meta name="twitter:image" content={SOCIAL_IMAGE} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE_ALT} />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem("starlight-theme");
        document.documentElement.dataset.theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- Previous nav: N9. This build: N8, because the real one-command CLI is
         the product's shortest path—not decorative terminal theatre. -->
    <header class="term-nav">
      <div class="term-nav-inner">
        <a class="brand" href={`${base}/`} aria-label="Codemble home">
          <img src={`${base}/brand/mark.svg`} alt="" width="32" height="32" />
          <span>Codemble</span>
        </a>
        <nav class="term-line" aria-label="Main navigation">
          <span class="term-prompt" aria-hidden="true">›</span>
          <a class="term-command" href="#start"><code>{INSTALL}</code></a>
          <a href="#tour">/tour</a>
          <a href="#download">/download</a>
          <a href={doc("introduction")}>/docs</a>
          <a href={REPO} rel="noopener">/source</a>
          <span class="term-caret" aria-hidden="true">▮</span>
        </nav>
        <div class="nav-tools">
          <Search />
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            aria-label="Switch to light theme"
          >
            <span data-theme-icon aria-hidden="true">☾</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="start">
        <div class="hero-copy">
          <p class="release-status">
            <span>Stable v{VERSION}</span>
            <span>Current source preview pictured</span>
          </p>
          <h1>Explore the code AI left behind.</h1>
          <p class="hero-lede">
            Codemble reads a project on your machine and turns its real structure
            into a galaxy you can explore or a diagram you can follow. Study real
            source, trace parser-proven routes as far as the evidence goes, see what
            a change reaches, and light only what you prove you understand.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#download">
              <img src={icon("download-on-fill")} alt="" width="20" height="20" />
              Download Codemble
            </a>
            <a class="button button-secondary" href={doc("quickstart")}>
              <img src={icon("run")} alt="" width="20" height="20" />
              Run in one command
            </a>
          </div>
          <div class="command" aria-label={`Command: ${INSTALL}`}>
            <span aria-hidden="true">›</span>
            <code>{INSTALL}</code>
            <button type="button" data-copy={INSTALL}>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <p class="version-note">
            The screen shows the current source preview. The command and downloads
            remain pinned to stable v{VERSION}, mirrored on GitHub with checksums.
          </p>
        </div>

        <figure class="hero-proof">
          <div
            class="product-viewport"
            tabindex="0"
            aria-label="Current Codemble galaxy. Scroll sideways to inspect the full-size app screen."
          >
            <img
              src={shot("galaxy.png")}
              alt="Current Codemble source preview showing 245 visible, colourful systems across nine languages in a luminous spiral galaxy, with parser-proven routes, ranked labels, 47 charted systems, eight unreadable fixtures, and Home resolved to codemble.cli without amber understanding light."
              width="1440"
              height="720"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>Current source preview · luminous Explore galaxy</span>
            <span>245 systems · nine languages · local only</span>
          </figcaption>
        </figure>
      </section>

      <section class="release-band" aria-label="Release status">
        <p>
          <strong>These captures preview the current source.</strong> Verified
          downloads remain v{VERSION}; the newer planetary visuals are not yet a published package.
        </p>
        <a href="#download">Choose a route →</a>
      </section>

      <section class="workbench" id="tour">
        <header class="section-head">
          <h2>See the whole project. Then follow one fact.</h2>
          <p>
            These are not mockups. Each frame is a fresh capture of this repository
            running through the current Codemble source, with the same Home and the
            same parser-owned graph.
          </p>
        </header>
        <AtlasJourney />
      </section>

      <section class="download" id="download">
        <header class="section-head">
          <h2>Choose the route that fits today.</h2>
          <p>
            Run without installing, download the exact wheel, or keep an editable
            source checkout. The command and artifacts below lead to stable v{VERSION}.
          </p>
        </header>

        <div class="download-layout" id="versions">
          <article class="stable-route">
            <div class="route-title">
              <img src={icon("package")} alt="" width="32" height="32" />
              <div>
                <p>Recommended</p>
                <h3>Run Codemble v{VERSION}</h3>
              </div>
            </div>
            <p>
              Best for a first real project. It is the latest GitHub release and
              PyPI package, with the exact wheel, source archive, and SHA256SUMS ledger
              mirrored on GitHub.
            </p>
            <ol class="run-steps">
              <li>
                <span>01</span>
                <div><strong>Install uv once</strong><code>brew install uv</code></div>
              </li>
              <li>
                <span>02</span>
                <div><strong>Open Codemble</strong><code>{INSTALL}</code></div>
              </li>
            </ol>
            <div class="artifact-links">
              <a class="button button-primary" href={WHEEL} download>
                <img src={icon("download-on-fill")} alt="" width="20" height="20" />
                Download wheel
              </a>
              <a href={SOURCE_ARCHIVE} download>
                <img src={icon("code")} alt="" width="20" height="20" />
                Source archive
              </a>
              <a href={DIGESTS}>
                <img src={icon("shield")} alt="" width="20" height="20" />
                SHA256 digests
              </a>
              <a href={RELEASE}>
                <img src={icon("release")} alt="" width="20" height="20" />
                Release notes
              </a>
            </div>
          </article>

          <aside class="source-route">
            <div class="route-title">
              <img src={icon("code")} alt="" width="32" height="32" />
              <div>
                <p>Editable</p>
                <h3>Build v{VERSION} from source</h3>
              </div>
            </div>
            <p>
              This checks out the stable v{VERSION} source that matches the
              verified package. Clone <code>main</code> only when you intentionally
              want the newer preview pictured above.
            </p>
            <pre><code>git clone --branch {release.tag} --depth 1 {REPO}.git
cd Codemble
python -m venv .venv
source .venv/bin/activate
pip install -e .
codemble</code></pre>
            <p class="route-footnote">
              Source builds are for testers and contributors. <a href={doc("build-from-source")}>Read the verified build guide.</a>
            </p>
          </aside>
        </div>
      </section>

      <section class="capabilities">
        <header class="section-head">
          <h2>What Codemble does, without the astronomy lesson.</h2>
          <p>
            Point it at a folder. Codemble reads supported source without running
            your app, package scripts, compilers, or tests.
          </p>
        </header>

        <dl class="capability-list">
          {
            capabilities.map((item) => (
              <div>
                <dt>
                  <img src={icon(item.icon)} alt="" width="24" height="24" />
                  {item.title}
                </dt>
                <dd>{item.body}</dd>
              </div>
            ))
          }
        </dl>

        <div class="language-ledger" aria-label="Supported languages">
          <strong>One project can mix:</strong>
          <span>Python</span><span>JavaScript</span><span>TypeScript</span>
          <span>Go</span><span>Java</span><span>Rust</span><span>C#</span>
          <span>Ruby</span><span>PHP</span>
        </div>
      </section>

      <section class="trust" id="trust">
        <header class="section-head">
          <h2>The map admits where certainty ends.</h2>
          <p>
            Codemble is for readers who may not yet spot a confident mistake.
            Accuracy therefore outranks visual drama, feature count, and model fluency.
          </p>
        </header>

        <div class="trust-layout">
          <ol class="contract-list">
            {
              contract.map((rule, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <p>{rule}</p>
                </li>
              ))
            }
          </ol>
          <aside class="privacy-ledger">
            <h3>Your machine is the boundary.</h3>
            <dl>
              <div><dt>Parsed locally</dt><dd>source · graph · maps · feature journeys</dd></div>
              <div><dt>Saved locally</dt><dd>progress · narration cache</dd></div>
              <div><dt>Works without AI</dt><dd>journeys · Impact · Lens · checks</dd></div>
              <div><dt>Optional network</dt><dd>opening Study sends bounded context to your chosen narrator</dd></div>
              <div><dt>Never present</dt><dd>accounts · telemetry · Codemble cloud</dd></div>
            </dl>
            <a href={doc("correctness")}>Read the correctness contract →</a>
          </aside>
        </div>
      </section>

      <section class="faq">
        <header class="section-head">
          <h2>Before you point it at a repository.</h2>
        </header>
        <div class="faq-list">
          <details>
            <summary>Does Codemble run my code?</summary>
            <p>No. It reads supported source files and parses their structure. It does not run the project, package scripts, compilers, or tests.</p>
          </details>
          <details>
            <summary>Do I need an Anthropic or OpenAI key?</summary>
            <p>No. The galaxy, maps, feature journeys, source, structural summary, Impact, Lens, checks, and saved progress all work without a model. If you configure a narrator, opening Study automatically requests grounded prose with bounded context.</p>
          </details>
          <details>
            <summary>Are these screenshots from the downloadable app?</summary>
            <p>They are fresh captures of the real current-source app. Stable v{VERSION} is the verified download; newer planetary detail shown here remains a preview until the next release passes its operational gate.</p>
          </details>
          <details>
            <summary>What happens when Codemble cannot prove a relationship?</summary>
            <p>It ends the proven route at a visible break, then shows only the possible frontier that can still lead toward your selected feature. Broken or unsupported source stays counted instead of vanishing from the picture.</p>
          </details>
        </div>
      </section>
    </main>

    <aside class="download-dock" data-download-dock hidden aria-label="Download Codemble">
      <p><strong>Codemble v{VERSION}</strong><span>One command · local project picker</span></p>
      <code>{INSTALL}</code>
      <a href="#download">
        <img src={icon("download-on-fill")} alt="" width="20" height="20" />
        Download
      </a>
    </aside>

    <!-- Ft4: a technical colophon, not a generic link catalogue. -->
    <footer class="colophon">
      <p>
        Codemble · Apache-2.0 · Python 3.11+ · local FastAPI server · React +
        three.js instrument · Formal Edo interface · v{VERSION}. No account,
        telemetry, hosted source, or invented structure.
      </p>
      <nav aria-label="Footer">
        <a href={doc("download")}>Download</a>
        <a href={doc("introduction")}>Docs</a>
        <a href={`${REPO}/blob/main/TESTING.md`}>Test it</a>
        <a href={REPO}>GitHub</a>
      </nav>
    </footer>

    <script>
      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLElement>("[data-theme-toggle]");
      const themeIcon = document.querySelector<HTMLElement>("[data-theme-icon]");

      const renderTheme = () => {
        const dark = root.dataset.theme !== "light";
        if (themeIcon) themeIcon.textContent = dark ? "☾" : "☀";
        themeButton?.setAttribute(
          "aria-label",
          dark ? "Switch to light theme" : "Switch to dark theme",
        );
      };

      themeButton?.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
        localStorage.setItem("starlight-theme", root.dataset.theme);
        renderTheme();
      });
      renderTheme();

      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const label = button.querySelector<HTMLElement>("[data-copy-label]");
          if (!label) return;
          try {
            if (!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
            await navigator.clipboard.writeText(button.dataset.copy || "");
            label.textContent = "Copied";
            button.dataset.copied = "";
          } catch {
            label.textContent = "Select command";
            button.dataset.copyFailed = "";
            const command = button.closest(".command")?.querySelector("code");
            const selection = window.getSelection();
            if (command && selection) {
              const range = document.createRange();
              range.selectNodeContents(command);
              selection.removeAllRanges();
              selection.addRange(range);
            }
          }
          window.setTimeout(() => {
            label.textContent = "Copy";
            delete button.dataset.copied;
            delete button.dataset.copyFailed;
          }, 2500);
        });
      });

      const dock = document.querySelector<HTMLElement>("[data-download-dock]");
      const tour = document.querySelector("#tour");
      const download = document.querySelector("#download");
      if (dock && tour && download && "IntersectionObserver" in window) {
        let tourReached = false;
        let downloadVisible = false;
        const renderDock = () => {
          dock.hidden = !tourReached || downloadVisible;
        };
        new IntersectionObserver(
          ([entry]) => {
            tourReached = entry.boundingClientRect.top < innerHeight * 0.55;
            renderDock();
          },
          { threshold: [0, 0.25] },
        ).observe(tour);
        new IntersectionObserver(
          ([entry]) => {
            downloadVisible = entry.isIntersecting;
            renderDock();
          },
          { threshold: 0.05 },
        ).observe(download);
      }
    </script>
  </body>
</html>
