---
/**
 * Workbench journey through the current product.
 *
 * A sticky desktop proof frame follows normal-flow copy. Compact and
 * reduced-motion layouts pair every step with its own full-size capture, so
 * the choreography is never required for meaning.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const shot = (file: string) => `${base}/shots/${file}`;

const scenes = [
  {
    id: "explore",
    label: "Explore",
    title: "Begin with a sky that is already readable.",
    body: "All 245 systems are visible and colourful on the first frame inside a luminous deterministic sky. Free exploration keeps the whole project alive; a guided First Flight may quiet distant context while it teaches one parser-owned route.",
    image: "galaxy.png",
    focus: "center",
    alt: "Current Codemble source preview with 245 visible, colourful systems across nine languages, a luminous spiral starfield, parser-proven route corridors, ranked labels, 47 charted systems, and Home resolved to codemble.cli without amber understanding light.",
  },
  {
    id: "map",
    label: "Map",
    title: "Flatten the same evidence into a reading path.",
    body: "Architecture lays modules out by proven imports from Home. Workflow follows certain calls from the entrypoint. Modules with no proven route remain in complete bottom rows rather than being guessed into the graph.",
    image: "map-architecture.png",
    focus: "center",
    alt: "Codemble’s Expert canvas Architecture map showing Home, connected server modules, real lines of code, and complete bottom rows for modules with no proven import route.",
  },
  {
    id: "system",
    label: "Land",
    title: "Enter a solar system with a real Sun.",
    body: "The module anchor becomes the system's Sun. Named functions and classes become language-styled worlds in parser-owned call placement, while the nearby-systems console continues along certain and possible imports without merging them. Land on any world for Easy or Expert evidence.",
    image: "system.png",
    focus: "center",
    alt: "Codemble’s codemble.cli solar system with a luminous Python module Sun, four named worlds in labelled call orbits, and seven nearby import routes whose certainty remains visible.",
  },
  {
    id: "impact",
    label: "Inspect",
    title: "Follow the feature route before a model speaks.",
    body: "Study follows parser-owned evidence only as far as it reaches from Home toward the selected feature. A visible proof break stops the journey before any separate possible frontier. Easy guides a cited step; Expert keeps that step and adds its parser rule, while selected-feature impact, connections, and test candidates stay clearly scoped.",
    image: "study-impact.png",
    focus: "end",
    alt: "Current Codemble source preview with the selected server app world beside the Expert Study panel, scrolled to its integrated Impact lists.",
  },
  {
    id: "prove",
    label: "Prove",
    title: "Earn the one colour that means understanding.",
    body: "Short checks come from the graph, never the narrator. Pass Home and its four parser-proven structures glow amber; the next useful route advances while charted systems remain a separate record of where you have been.",
    image: "home-proved.png",
    focus: "center",
    alt: "Codemble’s Home system after its checks were passed: all four parser-proven structures glow amber, Review understanding is available, and the next route points to codemble.adapters.project.",
  },
];
---

<div class="atlas-journey" data-atlas-journey data-scene="explore">
  <div class="journey-stage" aria-hidden="true">
    <div class="journey-frames">
      {
        scenes.map((scene, index) => (
          <figure
            class={`journey-frame journey-frame-${scene.id}`}
            data-journey-frame={scene.id}
            data-active={index === 0 ? "" : undefined}
          >
            <img
              src={shot(scene.image)}
              alt=""
              width="1440"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
    <p class="journey-caption"><span>Current source preview</span><span>same project · same Home</span></p>
  </div>

  <ol class="journey-steps">
    {
      scenes.map((scene, index) => (
        <li
          class="journey-step"
          data-journey-step={scene.id}
          data-current={index === 0 ? "" : undefined}
          aria-current={index === 0 ? "step" : undefined}
        >
          <figure class="journey-inline-media">
            <div
              class="journey-media-scroll"
              tabindex="0"
              data-scroll-focus={scene.focus}
              aria-label={`${scene.label} product screen. Scroll sideways to inspect it at a readable size.`}
            >
              <img
                src={shot(scene.image)}
                alt={scene.alt}
                width="1440"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>Current source preview · {scene.label}</figcaption>
          </figure>
          <p class="journey-label">{String(index + 1).padStart(2, "0")} · {scene.label}</p>
          <h3>{scene.title}</h3>
          <p>{scene.body}</p>
        </li>
      ))
    }
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-atlas-journey]").forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>("[data-journey-step]")];
    const frames = [...root.querySelectorAll<HTMLElement>("[data-journey-frame]")];
    const workbench = matchMedia(
      "(min-width: 72rem) and (prefers-reduced-motion: no-preference)",
    );
    const scrollableShots = matchMedia("(max-width: 56rem)");
    let observer: IntersectionObserver | undefined;

    const positionScrollableShots = () => {
      if (!scrollableShots.matches) return;
      root.querySelectorAll<HTMLElement>("[data-scroll-focus]").forEach((viewport) => {
        if (viewport.dataset.scrollPositioned === "") return;
        const remaining = viewport.scrollWidth - viewport.clientWidth;
        viewport.scrollLeft = viewport.dataset.scrollFocus === "end" ? remaining : remaining / 2;
        viewport.dataset.scrollPositioned = "";
      });
    };

    const activate = (id: string) => {
      if (!id || root.dataset.scene === id) return;
      root.dataset.scene = id;
      frames.forEach((frame) =>
        frame.toggleAttribute("data-active", frame.dataset.journeyFrame === id),
      );
      steps.forEach((step) => {
        const current = step.dataset.journeyStep === id;
        step.toggleAttribute("data-current", current);
        if (current) step.setAttribute("aria-current", "step");
        else step.removeAttribute("aria-current");
      });
    };

    const selectNearest = () => {
      const focusLine = innerHeight * 0.48;
      let nearest: HTMLElement | undefined;
      let distance = Number.POSITIVE_INFINITY;
      for (const step of steps) {
        const rect = step.getBoundingClientRect();
        if (rect.bottom <= 0 || rect.top >= innerHeight) continue;
        const nextDistance = Math.abs(rect.top + rect.height / 2 - focusLine);
        if (nextDistance >= distance) continue;
        nearest = step;
        distance = nextDistance;
      }
      if (nearest?.dataset.journeyStep) activate(nearest.dataset.journeyStep);
    };

    const connect = () => {
      observer?.disconnect();
      observer = undefined;
      if (!workbench.matches || !("IntersectionObserver" in window)) {
        activate(steps[0]?.dataset.journeyStep || "explore");
        return;
      }
      observer = new IntersectionObserver(selectNearest, {
        rootMargin: "-15% 0px -15% 0px",
        threshold: [0, 0.25, 0.5, 0.75, 1],
      });
      steps.forEach((step) => observer?.observe(step));
      selectNearest();
    };

    connect();
    requestAnimationFrame(positionScrollableShots);
    workbench.addEventListener("change", connect);
    scrollableShots.addEventListener("change", positionScrollableShots);
  });
</script>
