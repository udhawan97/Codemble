[Unit]
Description=Codemble daily full-data backup check and seven-day prune
After=local-fs.target
RequiresMountsFor=/mnt/codemble-restic
ConditionPathExists=/var/lib/codemble/share/.active.share-operations.lock
OnFailure=codemble-share-alert@%n.service

[Service]
Type=oneshot
User=root
Group=codemble-share
UMask=0077
ExecStart=/opt/codemble/bin/codemble share-ops operator-maintain --config /etc/codemble/share-operator.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/codemble/share /mnt/codemble-restic /var/cache/codemble-share-operator
